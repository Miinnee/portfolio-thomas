---
import { site, url } from '../data/site';
import '../styles/site.css';
interface Props { title?: string; description?: string }
const {title = 'Portfolio', description = 'Projets, compétences et réalisations de Thomas Chassang, développeur web et logiciel.'} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.startsWith(base) ? Astro.url.pathname.slice(base.length) || '/' : Astro.url.pathname;
---
<!doctype html>
<html lang="fr" data-theme="dark"><head>
  <script is:inline>
    (function () {
      var t = 'dark';
      try { t = localStorage.getItem('theme') || 'dark'; } catch (e) {}
      document.documentElement.dataset.theme = t;
    })();
  </script>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="theme-color" content="#0D0D0F" /><meta name="description" content={description} />
  <meta property="og:title" content={`${title} · ${site.name}`} /><meta property="og:description" content={description} />
  <meta property="og:image" content={url('/og-portfolio.svg')} />
  <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
  <title>{title} · {site.name}</title>
</head><body>
  <a class="skip" href="#contenu">Aller au contenu</a>
  <header class="nav"><div class="shell nav-inner">
    <a class="identity" href={url('/')}><span class="monogram">TC</span><span><strong>Thomas Chassang</strong><small>Développeur · Miinnee</small></span></a>
    <nav aria-label="Navigation principale">
      <a class:list={[{'selected': path === '/'}]} href={url('/')}>Accueil</a>
      <a class:list={[{'selected':path.startsWith('/projets')}]} href={url('/projets/')}>Projets</a>
      <a class:list={[{'selected':path.startsWith('/a-propos')}]} href={url('/a-propos/')}>À propos</a>
      <a class="nav-contact" href={`mailto:${site.email}`}>Me contacter</a>
      <button class="theme-toggle" type="button" aria-label="Basculer entre thème clair et sombre" title="Changer de thème">
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
      </button>
    </nav>
  </div></header>
  <slot />
  <footer class="footer"><div class="shell footer-inner"><span>© {new Date().getFullYear()} Thomas Chassang</span><span><a href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a> <a href={`mailto:${site.email}`}>Email</a></span></div></footer>
  <script is:inline>
    document.querySelector('.theme-toggle').addEventListener('click', function () {
      var root = document.documentElement;
      var next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
      document.querySelector('meta[name="theme-color"]').content = next === 'dark' ? '#0D0D0F' : '#F6F6F5';
    });
  </script>
</body></html>
