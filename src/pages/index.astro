---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site, url } from "../data/site";
const modules = import.meta.glob("../content/projects/*.md", { eager: true });
const projects = Object.entries(modules)
  .map(([path, mod]: any) => ({
    slug: path.split("/").pop().replace(".md", ""),
    ...mod,
  }))
  .sort(
    (a, b) =>
      (b.frontmatter.featured ? 1 : 0) - (a.frontmatter.featured ? 1 : 0),
  );
---

<Base title="Développeur web & logiciel">
  <main id="contenu">
    <section class="shell hero">
      <div class="hero-copy">
        <p class="availability">
          <span class="dot"></span> Recherche de stage · mai 2027
        </p>
        <h1>Thomas<br />Chassang<span class="accent-dot">.</span></h1>
        <p class="hero-role">
          Développeur web & logiciel, passionné par les projets
          qui prennent vie.
        </p>
        <p class="hero-description">
          Étudiant en BUT Informatique, je conçois des applications, des plugins
          Java et des outils web. Fondateur de <b>Projet Chronos</b>, j'aime
          bâtir des solutions complètes, du code à leur utilisation.
        </p>
        <div class="actions">
          <a class="button primary" href={url("/projets/")}
            >Voir mes projets</a
          ><a class="button ghost" href={url(site.cv)} download
            >Télécharger mon CV ↓</a>
        </div>
      </div><dl class="info-card">
        <div><dt>Formation</dt><dd>BUT Informatique, 2e année</dd></div>
        <div><dt>Spécialités</dt><dd>Java · Web · SQL</dd></div>
        <div><dt>Association</dt><dd>Fondateur de Projet Chronos</dd></div>
        <div><dt>Disponibilité</dt><dd>Stage à partir de mai 2027</dd></div>
      </dl>
    </section>
    <section class="shell focus-banner">
      <div>
        <span class="eyebrow">Stage 2027</span><h2>
          À la recherche de mon stage de fin d'année.
        </h2><p>
          {site.internship} · Développement web ou logiciel, prolongation possible
          en été.
        </p>
      </div><a
        href={`mailto:${site.email}?subject=Proposition%20de%20stage%20-%20Mai%202027`}
        class="button light">Discutons-en</a>
    </section>
    <section class="shell section">
      <div class="section-heading">
        <div>
          <span class="eyebrow">Projets</span><h2>
            Ce que je construis
          </h2>
        </div><a class="text-link" href={url("/projets/")}>Tous les projets</a>
      </div><div class="projects-grid">
        {
          projects
            .slice(0, 4)
            .map((project) => (
              <ProjectCard
                slug={project.slug}
                frontmatter={project.frontmatter}
              />
            ))
        }
      </div>
    </section>
    <section class="shell split-section">
      <div class="about-preview">
        <span class="eyebrow">Au-delà du code</span><h2>
          Construire, organiser, faire évoluer
        </h2><p>
          Avec Projet Chronos, je développe des outils Java et web tout en
          pilotant une association dédiée aux événements Minecraft. Une manière
          concrète de réunir architecture, autonomie et travail d'équipe.
        </p><a class="text-link" href={url("/a-propos/")}>En savoir plus sur moi</a>
      </div><div class="skill-panel">
        <div class="skill-header">Technologies</div><div
          class="skill-grid"
        >
          {site.stack.map((skill) => <span>{skill}</span>)}
        </div>
      </div>
    </section>
  </main>
</Base>
