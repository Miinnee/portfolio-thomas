---
import Base from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { site } from "../data/site";
const modules = import.meta.glob("../content/projects/*.md", { eager: true });
const projects = Object.entries(modules)
  .map(([path, mod]: any) => ({
    slug: path.split("/").pop().replace(".md", ""),
    ...mod,
  }))
  .sort(
    (a, b) =>
      (b.frontmatter.featured ? 1 : 0) - (a.frontmatter.featured ? 1 : 0),
  );
---

<Base title="Développeur web & logiciel">
  <main id="contenu">
    <section class="shell hero">
      <div class="hero-copy">
        <p class="availability">
          <span class="dot"></span> Recherche de stage · mai 2027
        </p>
        <h1>Thomas<br /><span>Chassang.</span></h1>
        <p class="hero-role">
          Développeur <strong>web & logiciel</strong>, passionné par les projets
          qui prennent vie.
        </p>
        <p class="hero-description">
          Étudiant en BUT Informatique, je conçois des applications, des plugins
          Java et des outils web. Fondateur de <b>Projet Chronos</b>, j'aime
          bâtir des solutions complètes, du code à leur utilisation.
        </p>
        <div class="actions">
          <a class="button primary" href="/projets/"
            >Découvrir mes projets <span>↗</span></a
          ><a class="button ghost" href={site.cv} download
            >Télécharger mon CV ↓</a>
        </div>
      </div><aside class="hero-side">
        <div class="terminal">
          <div class="terminal-top">
            <span class="lights"><i></i><i></i><i></i></span><span
              >thomas.profile.ts</span
            ><span class="live">● EN LIGNE</span>
          </div>
          <div class="terminal-code">
            <div><em>01</em> <b>const</b> developer = {`{`}</div><div>
              <em>02</em> &nbsp; name: <span>"Miinnee"</span>,
            </div><div>
              <em>03</em> &nbsp; focus: <span>"Full-stack"</span>,
            </div><div>
              <em>04</em> &nbsp; primary: <span>"Java"</span>,
            </div><div>
              <em>05</em> &nbsp; community: <span>"Projet Chronos"</span>,
            </div><div>
              <em>06</em> &nbsp; status: <span>"Stage 2027"</span>
            </div><div><em>07</em> {`}`};</div>
          </div>
          <div class="terminal-bottom">
            <div><span>FORMATION</span><b>BUT Informatique</b></div><div>
              <span>SPÉCIALITÉ</span><b>Java · Web · SQL</b>
            </div>
          </div>
        </div><div class="orbit" aria-hidden="true">
          <span>Java</span><span>JS</span><span>SQL</span>
        </div>
      </aside>
    </section>
    <section class="shell focus-banner">
      <div>
        <span class="eyebrow">OPPORTUNITÉ · 2027</span><h2>
          À la recherche de mon stage de fin d'année.
        </h2><p>
          {site.internship} · Développement web ou logiciel, prolongation possible
          en été.
        </p>
      </div><a
        href={`mailto:${site.email}?subject=Proposition%20de%20stage%20-%20Mai%202027`}
        class="button light">Discutons-en ↗</a>
    </section>
    <section class="shell section">
      <div class="section-heading">
        <div>
          <span class="eyebrow">01 / CE QUE JE CONSTRUIS</span><h2>
            Projets sélectionnés<span class="accent-dot">.</span>
          </h2>
        </div><a class="text-link" href="/projets/">Tous les projets ↗</a>
      </div><div class="projects-grid">
        {
          projects
            .slice(0, 4)
            .map((project) => (
              <ProjectCard
                slug={project.slug}
                frontmatter={project.frontmatter}
              />
            ))
        }
      </div>
    </section>
    <section class="shell split-section">
      <div class="about-preview">
        <span class="eyebrow">02 / AU-DELÀ DU CODE</span><h2>
          Construire, organiser,<br /><span>faire évoluer.</span>
        </h2><p>
          Avec Projet Chronos, je développe des outils Java et web tout en
          pilotant une association dédiée aux événements Minecraft. Une manière
          concrète de réunir architecture, autonomie et travail d'équipe.
        </p><a class="text-link" href="/a-propos/">En savoir plus sur moi ↗</a>
      </div><div class="skill-panel">
        <div class="skill-header">MES STACKS <span>↗</span></div><div
          class="skill-grid"
        >
          {site.stack.map((skill) => <span>{skill}</span>)}
        </div>
      </div>
    </section>
  </main>
</Base>
